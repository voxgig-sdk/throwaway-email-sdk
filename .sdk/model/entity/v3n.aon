# Entity: v3n

main: kit: entity: v3n: {

  alias: field: {}

  fields: [
    {
      name: "records"
      req: false
      short: "DNS records for the domain (when available)"
      type: "`$OBJECT`"
    }
    {
      name: "success"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "traits"
      req: true
      short: "Array of traits identified for the domain"
      type: "`$ARRAY`"
    }
  ]

  name: "v3n"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "test@example.com"
                kind: "param"
                name: "subject"
                orig: "subject"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v3/{subject}"
          parts: [
            "api"
            "v3"
            "{subject}"
          ]
          select: {
            exist: [
              "subject"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "v3"
      ]
    ]
  }



}
