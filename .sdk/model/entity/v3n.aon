  name: "v3n"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "test@example.com"
                kind: "param"
                name: "subject"
                orig: "subject"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /api/v3/{subject}"
            json: "{\"parameters\":[{\"description\":\"Email address or domain name to analyze\",\"in\":\"path\",\"name\":\"subject\",\"required\":true,\"schema\":{\"example\":\"test@example.com\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"clean-domain\":{\"summary\":\"Clean domain with no issues\",\"value\":{\"records\":{\"mx_ips\":[{\"exchange\":\"mail.example.com\",\"ips\":[\"203.0.113.10\",\"2001:db8::1\"]}],\"mx_records\":[{\"exchange\":\"mail.example.com\",\"priority\":10}],\"nameservers\":[{\"nameserver\":\"ns1.example.com\"},{\"nameserver\":\"ns2.example.com\"}]},\"success\":true,\"traits\":[]}},\"disposable\":{\"summary\":\"Disposable domain\",\"value\":{\"records\":{\"mx_ips\":[{\"exchange\":\"mail.tempmail-service.com\",\"ips\":[\"192.168.1.100\"]}],\"mx_records\":[{\"exchange\":\"mail.tempmail-service.com\",\"priority\":10}],\"nameservers\":[{\"nameserver\":\"ns1.suspicious-provider.com\"}]},\"success\":true,\"traits\":[\"disposable\"]}},\"disposable-no-mx-ip\":{\"summary\":\"Disposable domain with MX but no A/AAAA records\",\"value\":{\"records\":{\"mx_ips\":[{\"exchange\":\"nonexistent.mail.com\",\"ips\":[]}],\"mx_records\":[{\"exchange\":\"nonexistent.mail.com\",\"priority\":10}],\"nameservers\":[{\"nameserver\":\"ns1.suspicious-provider.com\"}]},\"success\":true,\"traits\":[\"disposable\",\"no_mx_ip\"]}},\"legitimate-domain\":{\"summary\":\"Legitimate domain (allowlisted)\",\"value\":{\"records\":{\"mx_ips\":[{\"exchange\":\"smtp.gmail.com\",\"ips\":[\"142.251.30.27\",\"2a00:1450:400c:c09::1a\"]},{\"exchange\":\"alt1.gmail-smtp-in.l.google.com\",\"ips\":[\"172.253.113.26\"]}],\"mx_records\":[{\"exchange\":\"smtp.gmail.com\",\"priority\":10},{\"exchange\":\"alt1.gmail-smtp-in.l.google.com\",\"priority\":20}],\"nameservers\":[{\"nameserver\":\"ns1.google.com\"},{\"nameserver\":\"ns2.google.com\"}]},\"success\":true,\"traits\":[\"allowlist\"]}},\"minimal-response\":{\"summary\":\"Minimal response without DNS records\",\"value\":{\"success\":true,\"traits\":[\"suspicious_pattern\"]}},\"no-mx-domain\":{\"summary\":\"Domain with no MX record\",\"value\":{\"records\":{\"nameservers\":[{\"nameserver\":\"ns1.example.com\"}]},\"success\":true,\"traits\":[\"no_mx\"]}}},\"schema\":{\"properties\":{\"records\":{\"description\":\"DNS records for the domain (when available)\",\"properties\":{\"mx_ips\":{\"description\":\"IP addresses for MX records\",\"items\":{\"properties\":{\"exchange\":{\"description\":\"Mail exchange hostname\",\"example\":\"mail.example.com\",\"type\":\"string\"},\"ips\":{\"description\":\"IP addresses (IPv4 and IPv6) for the MX server\",\"example\":[\"192.168.1.100\",\"2001:db8::1\"],\"items\":{\"description\":\"IP address\",\"example\":\"192.168.1.100\",\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"exchange\",\"ips\"],\"type\":\"object\"},\"type\":\"array\"},\"mx_records\":{\"description\":\"MX records for the domain\",\"items\":{\"properties\":{\"exchange\":{\"description\":\"Mail exchange hostname\",\"example\":\"mail.example.com\",\"type\":\"string\"},\"priority\":{\"description\":\"MX priority value\",\"example\":10,\"type\":\"integer\"}},\"required\":[\"priority\",\"exchange\"],\"type\":\"object\"},\"type\":\"array\"},\"nameservers\":{\"description\":\"NS records for the domain\",\"items\":{\"properties\":{\"nameserver\":{\"description\":\"Nameserver hostname\",\"example\":\"ns1.example.com\",\"type\":\"string\"}},\"required\":[\"nameserver\"],\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"success\":{\"example\":true,\"type\":\"boolean\"},\"traits\":{\"description\":\"Array of traits identified for the domain\",\"examples\":[[\"allowlist\"],[\"disposable\"],[\"disposable\",\"no_mx_ip\"],[\"no_mx\"],[\"no_mx_ip\"],[\"suspicious_mx\"],[\"suspicious_ns\"],[\"suspicious_ip\"],[\"suspicious_pattern\"],[\"suspicious_tld\"],[\"rbl_listed\"],[]],\"items\":{\"enum\":[\"disposable\",\"allowlist\",\"no_mx\",\"no_mx_ip\",\"suspicious_mx\",\"suspicious_ns\",\"suspicious_ip\",\"suspicious_pattern\",\"suspicious_tld\",\"rbl_listed\"],\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"success\",\"traits\"],\"type\":\"object\"}}},\"description\":\"Trait analysis result\",\"headers\":{\"X-RateLimit-Limit\":{\"description\":\"Rate limit maximum requests\",\"schema\":{\"type\":\"integer\"}},\"X-RateLimit-Remaining\":{\"description\":\"Rate limit remaining requests\",\"schema\":{\"type\":\"integer\"}},\"X-RateLimit-Reset\":{\"description\":\"Rate limit reset time (unix timestamp)\",\"schema\":{\"type\":\"integer\"}}}},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"message\":{\"type\":\"string\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Invalid input\"},\"429\":{\"description\":\"Rate limit exceeded\",\"headers\":{\"Retry-After\":{\"description\":\"Seconds to wait before retry\",\"schema\":{\"type\":\"integer\"}}}}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/v3/{subject}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v3"
            }
            {
              var: "subject"
            }
          ]
          select: {
            exist: [
              "subject"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

