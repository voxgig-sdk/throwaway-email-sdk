# Entity: v2n

main: kit: entity: v2n: {

  alias: field: {}

  fields: [
    {
      name: "isDisposable"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "v2n"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "test@example.com"
                kind: "param"
                name: "subject"
                orig: "subject"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v2/{subject}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v2"
            }
            {
              var: "subject"
            }
          ]
          select: {
            exist: [
              "subject"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "v2"
      ]
    ]
  }



}
